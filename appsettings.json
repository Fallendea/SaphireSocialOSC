{
  "IntervalInSeconds": 10,
  "RestConfig": {
    "Host": "https://saphiresocial.net/",
    "Token": "",
    "TimeoutInSeconds": 10
  },
  "OscClientConfig": {
    "Host": "127.0.0.1",
    "Port": 9000
  },
  "EventMappingConfig": {
    "Default": {
      "dm.received": {
        //"Enabled": true, //It defaults to true if u put nothing in. Put in 'false' if u don't want to react to this type of event
        //"Type": "bool", //It defaults to "bool" if u put nothing in
        "Parameter": "saphireSocial/dm/received"
      },
      "post.liked": {
        "Parameter": "saphireSocial/post/liked"
      },
      "post.commented": {
        "Parameter": "saphireSocial/post/commented"
      },
      "comment.liked": {
        "Parameter": "saphireSocial/comment/liked"
      },
      "comment.replied": {
        "Parameter": "saphireSocial/comment/replied"
      },
      "thread.replied": {
        "Parameter": "saphireSocial/thread/replied"
      },
      "follower.new": {
        "Parameter": "saphireSocial/follower/new"
      },
      "money.received": {
        "Parameter": "saphireSocial/money/received"
      }
    },
    "CharacterSpecificMapping": {
      //Here u can override the Mapping partly or completely for specific characters. What's not configured in here will be taken from Default above
      "@this-is-your-character-account": {
        "post.liked": {
          //Example, u want a different parameter just for this character
          "Parameter": "metagram/postLiked"
        },
        "follower.new": {
          //Example, u dont care for followers
          "Enabled": false
        },
        "dm.received": {
          //Example, instead of just getting that there is a message, u want to have the amount of messages.
          //Currently there is no listening to OSC, so u cant reset that count and it will just get bigger and bigger
          "Type": "int",
          "Parameter": "saphireSocial/dm/received"
        }
      },
      "@this-is-character-account-2": {
        //Example, instead of just getting that there is a message or how many there are, u want to have a % value.
        //In this case u also have to configure a Min & Max used to calculate the % with max 1.0. (Current - Min) / (Max - Min)
        //Currently there is no listening to OSC, so u cant reset that count, and it will just get bigger and bigger

        //E.g. Min = 0, Max = 4 with current count of messages = 0 ==> float = 0.0
        //E.g. Min = 0, Max = 4 with current count of messages = 2 ==> float = 0.5
        //E.g. Min = 0, Max = 4 with current count of messages = 4 ==> float = 1.0
        //E.g. Min = 0, Max = 4 with current count of messages = 5 ==> float = 1.0
        "dm.received": {
          "Type": "float",
          "Parameter": "saphireSocial/dm/received",
          "Min": 0,
          "Max": 4
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}